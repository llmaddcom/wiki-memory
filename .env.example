# 全部变量带 WIKIMEM_ 前缀；字段权威定义见 wiki_memory/config.py。
# 本文件是样例：只放占位值，真实凭据/公网地址绝不提交进仓库。

# ---- 数据库 ---------------------------------------------------------------
# sqlite 单文件（默认，零依赖起步）；换 Postgres 改成如下形式：
# WIKIMEM_DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/wiki_memory
WIKIMEM_DATABASE_URL=sqlite:///./wiki_memory.db

# ---- 固化/召回 LLM（OpenAI 兼容 /chat/completions 端点，指本地 vLLM 等） ----
WIKIMEM_LLM_BASE_URL=http://127.0.0.1:8000/v1
WIKIMEM_LLM_API_KEY=EMPTY
WIKIMEM_LLM_MODEL=your-model-name
# 单次 LLM 请求超时（秒），默认 300
#WIKIMEM_LLM_TIMEOUT_SECONDS=300

# ---- 语义召回 embedder（OpenAI 兼容 /embeddings 端点） ----------------------
# API_BASE 留空 = 语义召回通道关闭（recall method=embedding 返回 422）；
# bm25 / fuzzy / llm 召回不受影响，属优雅降级。要开语义召回需配 API_BASE 与 MODEL。
# MODEL 名同时是向量身份标：换模型后存量向量自动失效重算，无需人工迁移。
WIKIMEM_EMBEDDER_API_BASE=
WIKIMEM_EMBEDDER_API_KEY=EMPTY
WIKIMEM_EMBEDDER_MODEL=
# 单次 embed 请求超时（秒），默认 30
#WIKIMEM_EMBEDDER_TIMEOUT_SECONDS=30

# ---- 服务鉴权 -------------------------------------------------------------
# 设置后所有请求须带 X-API-Key 头；留空不鉴权（内网/本机模式）。
# 注意：这里一旦设值，createrole 侧必须同步设置 WIKI_MEMORY_API_KEY，
# 否则记忆读写全部 401，且上游表现为「静默空召回」（召回失败被当成无记忆）。
WIKIMEM_API_KEY=

# ---- 固化/召回旋钮 ---------------------------------------------------------
# 单次固化最多消费的 pending source 数，默认 20
#WIKIMEM_CONSOLIDATE_MAX_SOURCES=20
# 高显著性 pending source 临时召回阈值（salience ≥ 阈值的待固化材料参与 BM25 现算），默认 0.8
#WIKIMEM_PENDING_RECALL_MIN_SALIENCE=0.8
